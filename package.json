{
  "name": "kfc-automation",
  "version": "1.0.0",
  "description": "Automated E2E tests for KFC LATAM websites",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:regional": "playwright test flujoRegionalAnonimo.js --headed --workers=1",
    "test:regional:headless": "playwright test flujoRegionalAnonimo.js --workers=1",
    "test:ecuador": "playwright test ecuador/delivery/flujoAnonimoDel.js --headed",
    "test:ecuador:pickup": "playwright test ecuador/pickup/flujoAnonimoPickup.js --headed",
    "test:ecuador:registro": "playwright test ecuador/auth/flujoRegistroOtp.js --headed",
    "test:chile": "playwright test chile/delivery/flujoAnonimoDel.js --headed",
    "test:chile:pickup": "playwright test chile/pickup/flujoAnonimoPickup.js --headed",
    "test:colombia": "playwright test colombia/delivery/flujoAnonimoDel.js --headed",
    "test:colombia:pickup": "playwright test colombia/pickup/flujoAnonimoPickup.js --headed",
    "test:venezuela": "playwright test venezuela/delivery/flujoAnonimoDel.js --headed",
    "test:venezuela:pickup": "playwright test venezuela/pickup/flujoAnonimoPickup.js --headed",
    "test:brasil:pickup": "playwright test brasil/pickup/flujoAnonimoPickup.js --headed",
    "test:argentina:pickup": "playwright test argentina/pickup/flujoAnonimoPickup.js --headed",
    "report:ejecutivo": "node utils/abrirReporte.js",
    "report:tecnico": "playwright show-report playwright-report/tecnico"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^25.7.0"
  }
}
